{
  "name": "edge-ai-sidebar",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Floating message navigator for arena.ai — vanilla Shadow DOM UI",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:mirror && npm run test:unit",
    "test:mirror": "node scripts/test-content-extract.cjs && node scripts/test-round-grouping.cjs && node scripts/test-conversation-store.cjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.0",
    "@types/chrome": "^0.2.0",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^25.0.1",
    "oxlint": "^1.69.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^5.0.0"
  }
}
