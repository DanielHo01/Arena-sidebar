root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Code: tabs rendered as 2 columns — matches how the existing codebase was
# originally formatted (verified: tabWidth 2 → 31 changed lines, 4 → 207).
[*.{ts,tsx,js,cjs,mjs}]
indent_style = tab
indent_size = 2

[*.{json,jsonc,yml,yaml,html,css}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
